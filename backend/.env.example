PORT=8787
FRONTEND_ORIGIN=http://127.0.0.1:4173
NODE_ENV=production

# Where persisted creations are stored (JSON file store).
DATA_DIR=data

# Provider keys. The API runs in deterministic demo mode when these are empty,
# and switches to live Claude generation when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# Optional future provider keys.
OPENAI_API_KEY=
CLERK_SECRET_KEY=
