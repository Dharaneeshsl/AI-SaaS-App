# Frontend environment (copied into dist at build time via scripts/build.cjs)

# Backend API base URL.
# - Local dev: point straight at the backend, e.g. http://127.0.0.1:8787
# - Deployed (any non-localhost host): leave empty or keep the loopback value —
#   the app automatically switches to same-origin /api requests, which the
#   preview server (npm run preview) or your reverse proxy forwards to the
#   backend. Set a full URL here only if your API lives on a different domain.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Clerk publishable key for live auth + billing UI.
# Leave empty to run the full product in demo mode (guest user, no sign-in required).
VITE_CLERK_PUBLISHABLE_KEY=
